{
  "name": "airjam",
  "version": "0.1.0",
  "private": true,
  "description": "AirJam — Air Guitar acústica en tiempo real con Computer Vision y síntesis Karplus-Strong.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "prepare": "svelte-kit sync || echo \"\"",
    "icons": "node scripts/generate-icons.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vite-pwa/sveltekit": "^2.0.4",
    "magicast": "^0.5.5",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.77.0",
    "@mediapipe/tasks-vision": "^1.2.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
